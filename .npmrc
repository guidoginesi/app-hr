# Instalar @guidoginesi/pow-ui (privado) desde GitHub Packages.
# El token se toma de la env var NODE_AUTH_TOKEN (no se hardcodea acá).
# Instalar con:  NODE_AUTH_TOKEN=<TU_PAT> npm install @guidoginesi/pow-ui
@guidoginesi:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
